DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_ops_hub
REDIS_URL=redis://localhost:6379
NEXTAUTH_SECRET=change-this-secret
NEXTAUTH_URL=http://localhost:3000

# LLM provider
# mock   = 결정형 엔진만 (API key 불필요, 의도 레벨 컴플라이언스 검사 없음)
# openai = GPT 호출 (OPENAI_API_KEY 필요)
AI_PROVIDER=mock

# OpenAI
# 추천: gpt-4o-mini (월 $0.4 내외, 한국어 품질 양호)
# 품질 부족 시: gpt-4o, gpt-4.1-mini, gpt-4.1
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# 후순위: 다른 provider 로 전환 시 사용 (현재 미구현)
ANTHROPIC_API_KEY=

# 파일 스토리지
STORAGE_DRIVER=local
STORAGE_BUCKET=uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
