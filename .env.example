DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hospital_ops_hub
REDIS_URL=redis://localhost:6379
# NextAuth v5 — AUTH_SECRET 은 필수 (쿠키 서명). openssl rand -hex 32 로 생성 권장.
AUTH_SECRET=change-this-to-a-strong-random-string
# (선택) 배포 시 앱 URL. 개발에선 생략 가능.
# AUTH_URL=http://localhost:3001

# LLM provider
# mock   = 결정형 엔진만 (API key 불필요, 의도 레벨 컴플라이언스 검사 없음)
# openai = GPT 호출 (OPENAI_API_KEY 필요)
AI_PROVIDER=openai

# OpenAI
# 추천: gpt-4o-mini (월 $0.4 내외, 한국어 품질 양호)
# 품질 부족 시: gpt-4o, gpt-4.1-mini, gpt-4.1
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# 후순위: 다른 provider 로 전환 시 사용 (현재 미구현)
ANTHROPIC_API_KEY=

# Google (Gmail API) — 네이버 예약 이메일 자동 수신
# Google Cloud Console → OAuth 클라이언트(웹 애플리케이션) 생성 후 붙여넣기
# 승인된 리디렉션 URI: http://localhost:3001/api/integrations/gmail/callback (개발)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/gmail/callback
# (선택) 외부 cron/launchd 에서 /api/cron/gmail-poll 호출 시 Authorization: Bearer <secret>
CRON_SECRET=

# 네이버 예약 관리자 페이지 URL — /reservations 상단 바로가기 버튼
# 병원마다 bookingBusinessId 가 다름. 네이버 파트너 로그인 → 예약관리 → 주소창 URL 복사
NAVER_BOOKING_URL=https://partner.booking.naver.com/bizes/154371/booking-list-view?bookingBusinessId=154371

# 파일 스토리지
STORAGE_DRIVER=local
STORAGE_BUCKET=uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
